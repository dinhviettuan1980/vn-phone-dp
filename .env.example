DATABASE_URL=postgres://phoneintel:phoneintel@localhost:55432/phoneintel
PORT=3000
FIXTURES_BASE_URL=http://localhost:8899

# Remote dev database (VPS Postgres, no local/Docker Postgres needed).
# See docs/architecture.md "Remote dev database" for how this was set up.
# DATABASE_URL=postgres://phoneintel_user:<password>@103.163.216.32:5432/phoneintel

# Phase 2.5: acquisition engine production automation (services/crawler/config.py).
# All optional -- defaults shown below are what's used if unset.
# See docs/PHASE2_5_OPERATIONS.md for what each one controls.
MAX_JOBS_PER_SCHEDULER_RUN=10
MAX_ACTIVE_JOBS=5
SCHEDULER_INTERVAL_SECONDS=300
WORKER_CONCURRENCY=1
WORKER_IDLE_SLEEP_SECONDS=5
JOB_STALE_TIMEOUT_MINUTES=30

# Phase 2.6: 3-day production observation & monitoring.
# See docs/PHASE2_6_OBSERVATION.md.
OBSERVATION_DURATION_HOURS=72
# Set to the actual UTC/ISO timestamp when the observation window begins --
# left unset means "not started yet" (dashboard shows elapsed=0).
# OBSERVATION_STARTED_AT=2026-09-04T09:00:00Z
SYSTEM_METRICS_INTERVAL_SECONDS=300
MONITORING_DASHBOARD_REFRESH_SECONDS=60
QUEUE_WARNING_PENDING_JOBS=10
QUEUE_CRITICAL_PENDING_JOBS=30
QUEUE_WARNING_AGE_MINUTES=60
QUEUE_CRITICAL_AGE_MINUTES=180
