{
  "name": "phone-intelligence-platform",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev -w @phoneintel/api",
    "build": "npm run build -w @phoneintel/shared-types && npm run build -w @phoneintel/api",
    "test": "npm run test -w @phoneintel/api",
    "aggregate": "npm run aggregate -w @phoneintel/api",
    "stats": "npm run stats -w @phoneintel/api",
    "crawl": "cd services/crawler && python -m jobs.crawl_worker",
    "normalize": "cd services/crawler && python -m jobs.crawl_worker --normalize-only",
    "scheduler": "cd services/crawler && python -m jobs.scheduler",
    "worker": "cd services/crawler && python -m jobs.worker",
    "discover": "cd services/crawler && python -m cli.discover_domain",
    "ingest": "cd services/crawler && python -m cli.ingest_dataset",
    "acquisition:stats": "cd services/crawler && python -m tools.data_stats"
  }
}
